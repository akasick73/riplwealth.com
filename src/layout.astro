---
import './styles.css';
import './design-system.css';
import './motion.css';
import './v10.css';
import './v10-1.css';
const {title='RIPL Wealth | Build Tomorrow Today',description='Build financial freedom with purpose. RIPL connects financial planning and investing for business owners, athletes and people building their careers.',path='',noindex=false,profile=null,faq=[]}=Astro.props;
const rawPath=path||Astro.url.pathname;
const canonicalPath=rawPath==='/'?'/':`${rawPath.replace(/\/$/,'')}/`;
const canonical=new URL(canonicalPath,Astro.site).toString();
const nav=[['Financial Freedom','/financial-freedom/'],['How We Work','/how-we-work/'],['RIPL Portfolios','/wealth/'],['Money Questions','/money-questions/'],['Our Team','/about/']];
const preview=import.meta.env.PUBLIC_INDEXABLE!=='true';
const siteUrl=Astro.site?.toString()||'https://riplwealth.com/';
const organizationId=siteUrl+'#organization';
const pageName=title.replace(/\s*\| RIPL Wealth$/,'');
const articlePage=/^\/(business-owners|money-questions|structured-notes|concentrated-wealth)\/[^/]+\/$/.test(canonicalPath);
const image=new URL(profile?`/images/${profile.photo}`:'/images/ripl-home-team.jpg',siteUrl).href;
const parts=canonicalPath.split('/').filter(Boolean);
const labels={'business-owners':'Business Owners','money-questions':'Money Questions','structured-notes':'Structured Notes','concentrated-wealth':'Concentrated Wealth','team':'Our Team'};
const crumbs=[{name:'Home',url:siteUrl},...parts.map((part,index)=>({name:index===parts.length-1?pageName:(labels[part]||part.replace(/-/g,' ')),url:new URL('/'+parts.slice(0,index+1).join('/')+'/',siteUrl).href}))];
const graph=[
{'@type':'FinancialService','@id':organizationId,name:'RIPL Wealth',url:siteUrl,logo:new URL('/ripl-logo-periwinkle.png',siteUrl).href,telephone:'+1-970-419-9306',email:'hello@riplwealth.com',address:{'@type':'PostalAddress',streetAddress:'3711 John F Kennedy Parkway, Suite 225',addressLocality:'Fort Collins',addressRegion:'CO',postalCode:'80525',addressCountry:'US'}},
{'@type':'WebSite','@id':siteUrl+'#website',url:siteUrl,name:'RIPL Wealth',publisher:{'@id':organizationId},inLanguage:'en-US'},
{'@type':profile?'ProfilePage':faq.length?'FAQPage':'WebPage','@id':canonical+'#webpage',url:canonical,name:pageName,description,isPartOf:{'@id':siteUrl+'#website'},about:{'@id':organizationId},inLanguage:'en-US',...(profile?{mainEntity:{'@id':canonical+'#person'}}:faq.length?{mainEntity:faq.map(item=>({'@type':'Question',name:item.q,acceptedAnswer:{'@type':'Answer',text:item.a}}))}:{})},
...(parts.length?[{'@type':'BreadcrumbList','@id':canonical+'#breadcrumbs',itemListElement:crumbs.map((item,index)=>({'@type':'ListItem',position:index+1,name:item.name,item:item.url}))}]:[]),
...(articlePage?[{'@type':'Article','@id':canonical+'#article',headline:pageName,description,mainEntityOfPage:{'@id':canonical+'#webpage'},author:{'@id':organizationId},publisher:{'@id':organizationId},inLanguage:'en-US'}]:[]),
...(profile?[{'@type':'Person','@id':canonical+'#person',name:profile.name,jobTitle:profile.role,url:canonical,image,worksFor:{'@id':organizationId}}]:[])
];

---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#130F2A"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Rokkitt:wght@400;500;600;700&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"/><title>{title}</title><meta name="description" content={description}/>{(noindex||preview)&&<meta name="robots" content="noindex,nofollow"/>}<link rel="canonical" href={canonical}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content="website"/><meta property="og:image" content={image}/><meta property="og:site_name" content="RIPL Wealth"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={image}/><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':graph}).replace(/</g,'\\u003c')}/></head><body><a class="skip-link" href="#main">Skip to content</a>
<header><nav class="nav" aria-label="Main navigation"><a class="ripl-brand" href="/" aria-label="RIPL home"><img src="/ripl-logo.png" alt="RIPL"/><small>BUILD TOMORROW TODAY</small></a><div class="navlinks"><details class="audience-menu"><summary>Who We Help</summary><div><a href="/business-owners/">Business Owners</a><a href="/athletes/">Athletes &amp; Families</a><a href="/assessment/?track=career">Career &amp; Life: Your Wealth Persona</a></div></details>{nav.map(([label,url])=><a href={url} aria-current={rawPath===url?'page':undefined}>{label}</a>)}</div><div class="nav-actions"><a class="nav-assessment" href="/assessment/">Take the Quiz</a><a class="nav-cta" href="/contact/">Talk to the Team</a></div><details class="mobile"><summary>Menu</summary><div class="mobile-menu"><a href="/business-owners/">Business Owners</a><a href="/athletes/">Athletes &amp; Families</a><a href="/assessment/?track=career">Career &amp; Life</a><a href="/money-mindsets/">Money Mindsets</a><a href="/ripl-effect/">The RIPL Effect</a><a href="/compound-interest-calculator/">Compound Interest Calculator</a>{nav.map(([label,url])=><a href={url}>{label}</a>)}<a href="/assessment/">Take the Quiz</a><a href="/contact/">Talk to the Team</a></div></details></nav></header>
<main id="main">{articlePage&&<div class="wrap" style="padding-top:24px"><nav class="breadcrumbs" aria-label="Breadcrumb"><ol>{crumbs.map((crumb,index)=><li>{index===crumbs.length-1?<span aria-current="page">{crumb.name}</span>:<a href={crumb.url===siteUrl?'/':new URL(crumb.url).pathname}>{crumb.name}</a>}</li>)}</ol></nav></div>}<slot/></main>
<footer><div class="wrap"><div class="footer-top"><a class="ripl-brand" href="/" aria-label="RIPL home"><img src="/ripl-logo.png" alt="RIPL"/><small>BUILD TOMORROW TODAY</small></a><div><p>3711 John F Kennedy Parkway, Suite 225<br/>Fort Collins, CO 80525</p><a href="tel:+19704199306">(970) 419-9306</a><br/><a href="mailto:hello@riplwealth.com">hello@riplwealth.com</a></div><div class="footer-links"><a href="/financial-freedom/">Financial Freedom</a><a href="/how-we-work/">SAGE™ + RIPL Portfolios</a><a href="/wealth/">RIPL Portfolios</a><a href="/business-owners/">Business Owners</a><a href="/athletes/">Athletes &amp; Families</a><a href="/assessment/">Wealth Persona Quiz</a><a href="/money-mindsets/">Money Mindsets</a><a href="/compound-interest-calculator/">Compound Interest Calculator</a><a href="/ripl-effect/">The RIPL Effect</a><a href="/money-questions/">Money Questions</a><a href="/structured-notes/">Structured Notes</a><a href="/financial-transitions/">Financial Transitions</a><a href="/retirement/">Retirement</a><a href="/about/">Our Team</a><a href="/ask-ripl/">Ask RIPL</a></div></div><div class="footer-legal"><p>Investment advisory services are provided through RIPL Wealth, LLC, a registered investment adviser. Registration does not imply a certain level of skill or training.</p><p>Information is educational and is not individualized investment, tax, or legal advice. All investing involves risk, including possible loss of principal. Past performance does not guarantee future results. Advisory services are offered only where RIPL is properly registered or qualifies for an exemption.</p><p><a href="/privacy/">Privacy</a> · <a href="/disclosures/">Disclosures</a> · © {new Date().getFullYear()} RIPL Wealth LLC</p></div></div></footer><button class="motion-toggle" type="button" data-motion-toggle aria-pressed="false" hidden>Pause motion</button><script>import './motion.js';</script></body></html>
