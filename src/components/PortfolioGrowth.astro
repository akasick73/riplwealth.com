---
import {compoundProjection} from '../compound-math.js';
const rows=compoundProjection({principal:500000,years:15,rate:8,contribution:0,frequency:'monthly'});
const ending=rows.at(-1).balance;
const money=new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0});
const compact=new Intl.NumberFormat('en-US',{notation:'compact',maximumFractionDigits:1});
const formats=[{name:'desktop',width:640,height:310,left:65,right:20,bottom:40},{name:'mobile',width:400,height:280,left:58,right:12,bottom:36}];
---
<figure class="portfolio-growth">
<div class="eyebrow">A HYPOTHETICAL ILLUSTRATION</div><h2>Growth with purpose.</h2>
<div class="portfolio-growth-stat"><span>$500,000 over 15 years at an assumed 8%</span><strong>{money.format(ending)}</strong><small>Hypothetical ending balance</small></div>
<div class="growth-legend"><span>Hypothetical balance</span><span>Starting investment</span></div>
{formats.map(f=>{
 const top=1800000,x=y=>f.left+(f.width-f.left-f.right)*y/15,plotY=v=>f.height-f.bottom-(f.height-f.bottom-18)*v/top;
 return <svg class={`portfolio-growth-chart growth-${f.name}`} viewBox={`0 0 ${f.width} ${f.height}`} role="img" aria-labelledby={`growth-${f.name}-title growth-${f.name}-desc`}>
 <title id={`growth-${f.name}-title`}>Hypothetical annual compound growth over fifteen years</title><desc id={`growth-${f.name}-desc`}>Starting with $500,000 and assuming a constant 8% annual return, with no additional contributions, the illustration reaches {money.format(ending)} before fees, taxes and inflation. This is not actual portfolio performance.</desc>
 {[0,600000,1200000,1800000].map(v=><g><line x1={f.left} y1={plotY(v)} x2={f.width-f.right} y2={plotY(v)} stroke="#DCDCE8"/><text x={f.left-9} y={plotY(v)+4} text-anchor="end" fill="#3D3D58" font-size="13">${compact.format(v)}</text></g>)}
 <line x1={f.left} y1={plotY(500000)} x2={f.width-f.right} y2={plotY(500000)} stroke="#6355B8" stroke-width="2"/>
 <polyline points={rows.map(r=>`${x(r.year)},${plotY(r.balance)}`).join(' ')} fill="none" stroke="#C9963A" stroke-width="3" stroke-linejoin="round"/>
 <circle cx={x(15)} cy={plotY(ending)} r="4" fill="#C9963A"/>
 {[0,5,10,15].map(y=><text x={x(y)} y={f.height-10} text-anchor={y===0?'start':y===15?'end':'middle'} fill="#3D3D58" font-size="14">{y===0?'Today':`Year ${y}`}</text>)}
 </svg>;
})}
<figcaption>Assumes a constant 8% annual rate, annual compounding and no additional contributions or withdrawals. Excludes advisory fees, investment expenses, taxes and inflation. This is a mathematical example, not actual RIPL performance, a forecast or a guaranteed return. Actual returns vary and investments can lose value.</figcaption>
<a class="text-link" href="/compound-interest-calculator/">Explore your own assumptions →</a>
</figure>
