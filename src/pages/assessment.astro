---
import Layout from "../layout.astro";
const quizCSS=" .persona-quiz { \n  &{\n    --void:#130F2A;\n    --void-raised:#1B1640;\n    --void-raised-2:#221B4D;\n    --line:rgba(184,168,232,0.18);\n    --line-strong:rgba(184,168,232,0.32);\n    --ink:#F5F3FB;\n    --ink-muted:#AFA8CE;\n    --ink-faint:#7B739E;\n    --gold:#C9963A;\n    --gold-bright:#E3B564;\n    --gold-ink:#2A1D08;\n    --periwinkle:#B8A8E8;\n    --indigo:#6355B8;\n    --radius-card:20px;\n    --radius-ctl:12px;\n    --maxw:640px;\n  }\n\n  *{box-sizing:border-box;}\n  html{-webkit-text-size-adjust:100%;}\n  &{\n    background:var(--void);\n    color:var(--ink);\n    font-family:\"DM Sans\", ui-sans-serif, system-ui, sans-serif;\n    line-height:1.5;\n    background-image:\n      radial-gradient(circle at 12% -10%, rgba(99,85,184,0.35), transparent 55%),\n      radial-gradient(circle at 88% 0%, rgba(201,150,58,0.14), transparent 45%);\n    background-repeat:no-repeat;\n  }\n  h1,h2,h3,.display{\n    font-family:\"Rokkitt\", ui-serif, Georgia, serif;\n    font-weight:600;\n    text-wrap:balance;\n    letter-spacing:-0.01em;\n    margin:0;\n  }\n  .mono{font-family:\"DM Mono\", ui-monospace, SFMono-Regular, monospace; font-variant-numeric:tabular-nums;}\n  p{margin:0;}\n  button{font:inherit; color:inherit;}\n  input{font:inherit; color:inherit;}\n\n  .shell{\n    max-width:var(--maxw);\n    margin:0 auto;\n    padding:20px 18px 64px;\n    min-height:100%;\n  }\n\n  .topbar{\n    display:flex;\n    align-items:center;\n    justify-content:space-between;\n    gap:16px;\n    padding:6px 2px 22px;\n  }\n  .wordmark{\n    font-family:\"Rokkitt\", serif;\n    font-weight:700;\n    font-size:17px;\n    letter-spacing:0.02em;\n    color:var(--gold);\n  }\n\n  .progress-wrap{display:flex; align-items:center; gap:10px;}\n  .progress-label{\n    font-family:\"DM Mono\", monospace;\n    font-size:11.5px;\n    color:var(--ink-faint);\n    letter-spacing:0.04em;\n    white-space:nowrap;\n  }\n  .progress-track{width:96px; height:4px; border-radius:99px; background:var(--void-raised-2); overflow:hidden;}\n  .progress-fill{height:100%; background:linear-gradient(90deg, var(--indigo), var(--gold)); border-radius:99px; transition:width .35s ease;}\n\n  .card{\n    background:var(--void-raised);\n    border:1px solid var(--line);\n    border-radius:var(--radius-card);\n    padding:30px 26px 28px;\n  }\n\n  .screen{opacity:1; transform:translateY(0); transition:opacity .28s ease, transform .28s ease;}\n  .screen.enter{opacity:0; transform:translateY(8px);}\n\n  /* ---------- Landing ---------- */\n  .landing{text-align:left; padding:14px 2px 0;}\n  .landing h1{font-size:clamp(32px, 8vw, 46px); line-height:1.1; margin-top:6px;}\n  .landing .sub{margin-top:14px; font-size:16px; color:var(--ink-muted); max-width:48ch; line-height:1.5;}\n  .cta-primary{\n    margin-top:28px;\n    display:inline-flex;\n    align-items:center;\n    gap:10px;\n    background:var(--gold);\n    color:var(--gold-ink);\n    border:none;\n    border-radius:99px;\n    padding:15px 24px;\n    font-weight:700;\n    font-size:15.5px;\n    cursor:pointer;\n    transition:background .15s ease, transform .1s ease;\n  }\n  .cta-primary:hover{background:var(--gold-bright);}\n  .cta-primary:active{transform:scale(0.98);}\n  .cta-primary:disabled{opacity:0.4; cursor:not-allowed;}\n  .cta-primary svg{width:16px; height:16px; flex:none;}\n  .trust-line{margin-top:14px; font-size:12.5px; color:var(--ink-faint);}\n  .preview-entry{\n    display:block;\n    margin-top:22px;\n    background:none; border:none;\n    color:var(--ink-faint);\n    font-size:12px;\n    text-decoration:underline;\n    text-underline-offset:3px;\n    cursor:pointer;\n    padding:0;\n  }\n  .preview-entry:hover{color:var(--periwinkle);}\n\n  /* ---------- Question shell ---------- */\n  .q-title{font-size:clamp(23px,6vw,29px); line-height:1.22; text-wrap:wrap;}\n\n  .nav-row{margin-top:26px; display:flex; align-items:center; justify-content:space-between; gap:14px;}\n  .back-link{\n    background:none; border:none; cursor:pointer;\n    color:var(--ink-faint);\n    font-size:13.5px;\n    display:flex; align-items:center; gap:6px;\n    padding:8px 2px;\n  }\n  .back-link:hover{color:var(--ink-muted);}\n  .eyebrow-q{font-family:\"DM Mono\", monospace; font-size:11.5px; letter-spacing:0.12em; text-transform:uppercase; color:var(--gold-bright);}\n\n  /* ---------- Rate screens (mindset statements, binary tap) ---------- */\n  .rate-scale{margin-top:14px; display:flex; gap:8px;}\n  .rate-btn{\n    flex:1;\n    text-align:center;\n    background:var(--void-raised-2);\n    border:1px solid var(--line);\n    border-radius:var(--radius-ctl);\n    padding:13px 8px;\n    font-size:14px;\n    line-height:1.25;\n    font-weight:600;\n    cursor:pointer;\n    color:var(--ink-muted);\n    transition:border-color .15s ease, background .15s ease, color .15s ease;\n  }\n  .rate-btn:hover{border-color:var(--line-strong);}\n  .rate-btn.selected{\n    border-color:var(--gold);\n    background:rgba(201,150,58,0.14);\n    color:var(--ink);\n  }\n\n  .rate-group-item{margin-top:20px; padding-top:20px; border-top:1px solid var(--line);}\n  .rate-group-item:first-child{margin-top:0; padding-top:0; border-top:none;}\n  .rate-group-item .q-title{font-size:clamp(16.5px,4.4vw,19px); line-height:1.3;}\n  .rate-group-item .rate-scale{margin-top:12px;}\n\n  /* ---------- Duel screens (aggression pairs) ---------- */\n  .options{margin-top:22px; display:flex; flex-direction:column; gap:10px;}\n  .opt{\n    text-align:left;\n    display:flex;\n    align-items:center;\n    gap:12px;\n    width:100%;\n    background:var(--void-raised-2);\n    border:1px solid var(--line);\n    border-radius:var(--radius-ctl);\n    padding:14px 16px;\n    cursor:pointer;\n    transition:border-color .15s ease, background .15s ease;\n    font-size:15px;\n    color:var(--ink);\n  }\n  .opt:hover{border-color:var(--line-strong);}\n  .opt .mark{\n    flex:none;\n    width:20px; height:20px;\n    border-radius:99px;\n    border:1.5px solid var(--ink-faint);\n    display:flex; align-items:center; justify-content:center;\n    transition:border-color .15s ease, background .15s ease;\n  }\n  .opt .mark svg{width:11px; height:11px; opacity:0; transition:opacity .1s ease;}\n  .opt.selected{border-color:var(--gold); background:rgba(201,150,58,0.10);}\n  .opt.selected .mark{background:var(--gold); border-color:var(--gold);}\n  .opt.selected .mark svg{opacity:1;}\n  .opt-duel{padding:20px 18px; font-size:16px; line-height:1.4;}\n  .duel-divider{\n    text-align:center;\n    font-family:\"DM Mono\", monospace;\n    font-size:11px;\n    letter-spacing:0.14em;\n    text-transform:uppercase;\n    color:var(--ink-faint);\n    margin:-1px 0;\n  }\n\n  /* ---------- Contact ---------- */\n  .field{display:flex; flex-direction:column; gap:7px; margin-top:16px;}\n  .field label{font-size:12.5px; color:var(--ink-muted); font-weight:500;}\n  .field input{\n    background:var(--void-raised-2);\n    border:1px solid var(--line);\n    border-radius:var(--radius-ctl);\n    padding:13px 14px;\n    font-size:15.5px;\n    outline:none;\n  }\n  .field input:focus{border-color:var(--periwinkle);}\n  .field .opt-tag{color:var(--ink-faint); font-weight:400;}\n  .privacy-line{margin-top:16px; font-size:12px; color:var(--ink-faint); line-height:1.5;}\n  .next-btn{\n    background:var(--gold);\n    color:var(--gold-ink);\n    border:none;\n    border-radius:99px;\n    padding:13px 22px;\n    font-weight:700;\n    font-size:14.5px;\n    cursor:pointer;\n  }\n  .next-btn:disabled{opacity:0.32; cursor:not-allowed;}\n\n  /* ---------- Results ---------- */\n  .result-head{padding:6px 0 4px;}\n  .result-head .eyebrow{\n    font-family:\"DM Mono\", monospace;\n    font-size:11px;\n    letter-spacing:0.12em;\n    text-transform:uppercase;\n    color:var(--ink-faint);\n  }\n  .result-head h1{\n    margin-top:6px;\n    font-size:clamp(27px,7.5vw,36px);\n    line-height:1.16;\n  }\n  .result-head h1 .highlight{color:var(--gold-bright);}\n\n  .result-intro{margin-top:16px; font-size:15.5px; color:var(--ink-muted); line-height:1.6;}\n\n  .feature-card{\n    margin-top:22px;\n    border-radius:16px;\n    padding:22px;\n    border:1px solid var(--line);\n  }\n  .feature-card.strong{background:linear-gradient(160deg, rgba(201,150,58,0.14), rgba(201,150,58,0.04));}\n  .feature-card.gap{background:linear-gradient(160deg, rgba(99,85,184,0.22), rgba(184,168,232,0.05));}\n  .feature-card h3{\n    font-size:13px;\n    letter-spacing:0.08em;\n    text-transform:uppercase;\n    font-family:\"DM Mono\", monospace;\n    font-weight:500;\n  }\n  .feature-card.strong h3{color:var(--gold-bright);}\n  .feature-card.gap h3{color:var(--periwinkle);}\n  .point{margin-top:16px;}\n  .point:first-of-type{margin-top:18px;}\n  .point .point-head{font-size:16px; font-weight:700; font-family:\"Rokkitt\", serif;}\n  .point .point-&{margin-top:5px; font-size:14.5px; color:var(--ink-muted); line-height:1.55;}\n  .feature-card.next{background:linear-gradient(160deg, rgba(99,85,184,0.20), rgba(99,85,184,0.05));}\n  .feature-card.next h3{color:var(--indigo);}\n\n  .bullet-list{margin-top:16px; padding-left:0; list-style:none; display:flex; flex-direction:column; gap:9px;}\n  .bullet-list li{position:relative; padding-left:19px; font-size:14.5px; font-weight:700; color:var(--ink); font-family:\"Rokkitt\", serif;}\n  .bullet-list li::before{content:\"\"; position:absolute; left:0; top:7px; width:6px; height:6px; border-radius:99px; background:var(--gold-bright);}\n  .point-tie{margin-top:16px; font-size:14.5px; color:var(--ink-muted); line-height:1.6;}\n\n  .persona-icon{\n    width:52px; height:52px;\n    border-radius:99px;\n    border:1.5px solid var(--line-strong);\n    background:var(--void-raised-2);\n    display:flex; align-items:center; justify-content:center;\n    margin-bottom:14px;\n  }\n  .persona-icon svg{width:26px; height:26px;}\n\n  .core-drives{margin-top:20px; display:flex; flex-direction:column; gap:10px;}\n  .core-drives p{font-size:14.5px; color:var(--ink-muted); line-height:1.55;}\n  .drive-label{display:block; font-family:\"DM Mono\", monospace; font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:var(--gold-bright); margin-bottom:2px;}\n\n  .preview-nav{\n    position:fixed; top:0; left:0; right:0; z-index:999;\n    display:flex; flex-wrap:wrap; gap:6px;\n    padding:10px 12px;\n    background:rgba(19,15,42,0.96);\n    border-bottom:1px solid var(--line-strong);\n    backdrop-filter:blur(6px);\n  }\n  .preview-nav-label{\n    font-family:\"DM Mono\", monospace; font-size:10.5px; letter-spacing:0.08em; text-transform:uppercase;\n    color:var(--ink-faint); display:flex; align-items:center; padding-right:4px;\n  }\n  .preview-btn{\n    background:var(--void-raised-2);\n    border:1px solid var(--line);\n    color:var(--ink-muted);\n    font-size:12px;\n    font-weight:600;\n    padding:6px 11px;\n    border-radius:99px;\n    cursor:pointer;\n    white-space:nowrap;\n  }\n  .preview-btn:hover{border-color:var(--gold); color:var(--ink);}\n  .preview-btn.preview-btn-ghost{color:var(--gold-bright); border-color:var(--gold);}\n  &:has(.preview-nav) .shell{padding-top:64px;}\n\n  .disclaimer{margin-top:26px; font-size:12px; color:var(--ink-faint); line-height:1.6; border-left:2px solid var(--line-strong); padding-left:12px;}\n\n  .cta-card{\n    margin-top:22px;\n    background:var(--void-raised-2);\n    border:1px solid var(--line);\n    border-radius:16px;\n    padding:22px;\n  }\n  .cta-card h3{font-size:19px;}\n  .cta-card p{margin-top:8px; font-size:14px; color:var(--ink-muted); line-height:1.55;}\n  .cta-card .cta-primary{margin-top:16px; width:100%; justify-content:center;}\n\n  .restart{\n    display:block;\n    text-align:center;\n    margin:22px auto 0;\n    background:none; border:none;\n    color:var(--ink-faint);\n    font-size:12.5px;\n    cursor:pointer;\n    text-decoration:underline;\n    text-underline-offset:3px;\n  }\n\n  @media (prefers-reduced-motion: reduce){\n    .screen, .screen.enter, .progress-fill{transition:none !important;}\n  }\n }\n.persona-quiz{background:#130F2A;color:#F4F3F8;padding:40px 0 70px;min-height:75vh}.persona-quiz [hidden]{display:none!important}.persona-quiz :focus-visible{outline:3px solid #C9963A;outline-offset:3px}.persona-quiz .progress-label,.persona-quiz .eyebrow-q,.persona-quiz .drive-label,.persona-quiz .result-head .eyebrow{font-size:12px}.persona-quiz .trust-line,.persona-quiz .privacy-line,.persona-quiz .disclaimer{font-size:14px;color:#B8B2CC}.persona-quiz .feature-card.next h3{color:#B8A8E8}.persona-quiz .delivery-status{padding:16px 0;color:#DCDCE8;font-size:14px}.persona-quiz .overlap-note{color:#B8A8E8;font-size:14px;margin-top:15px}";
const quizHTML="<div class=\"shell\">\n  <div class=\"topbar\">\n    <div class=\"wordmark\">RIPL</div>\n    <div class=\"progress-wrap\" id=\"progressWrap\" hidden>\n      <span class=\"progress-label mono\" id=\"progressLabel\">1 / 5</span>\n      <div class=\"progress-track\"><div class=\"progress-fill\" id=\"progressFill\" style=\"width:0%\"></div></div>\n    </div>\n  </div>\n\n  <!-- LANDING -->\n  <section class=\"screen landing\" id=\"screen-landing\">\n    <h1>What's your wealth persona?</h1>\n    <p class=\"sub\">Built for business owners. Find out how the way you think about money is shaping your future.</p>\n    <button class=\"cta-primary\" id=\"startBtn\">\n      Let's Find Out\n      <svg viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M3 8h10M9 4l4 4-4 4\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n    </button>\n    <p class=\"trust-line\">Takes about 3 minutes.</p>\n    \n  </section>\n\n  <!-- RATE (2-3 mindset statements per screen) -->\n  <section class=\"screen card\" id=\"screen-rate\" hidden>\n    <span class=\"eyebrow-q\" id=\"rateEyebrow\"></span>\n    <div id=\"rateGroupItems\" style=\"margin-top:8px;\"></div>\n    <div class=\"nav-row\">\n      <button class=\"back-link\" id=\"rateBackBtn\">\n        <svg viewBox=\"0 0 16 16\" width=\"13\" height=\"13\" fill=\"none\"><path d=\"M13 8H3M7 4L3 8l4 4\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n        Back\n      </button>\n      <button class=\"next-btn\" id=\"rateContinueBtn\" disabled>Continue</button>\n    </div>\n  </section>\n\n  <!-- DUELS (all five tendency pairs on one screen) -->\n  <section class=\"screen card\" id=\"screen-duel\" hidden>\n    <span class=\"eyebrow-q\" id=\"duelEyebrow\"></span>\n    <h2 class=\"q-title\" id=\"duelTitle\" style=\"margin-top:8px;\">For each pair, which one sounds more like you?</h2>\n    <div id=\"duelGroupItems\"></div>\n    <div class=\"nav-row\">\n      <button class=\"back-link\" id=\"duelBackBtn\">\n        <svg viewBox=\"0 0 16 16\" width=\"13\" height=\"13\" fill=\"none\"><path d=\"M13 8H3M7 4L3 8l4 4\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n        Back\n      </button>\n      <button class=\"next-btn\" id=\"duelContinueBtn\" disabled>See My Results</button>\n    </div>\n  </section>\n\n  <!-- CONTACT -->\n  <section class=\"screen card\" id=\"screen-contact\" hidden>\n    <h2 class=\"q-title\">Your results are ready.</h2>\n    <p style=\"margin-top:9px; color:var(--ink-muted); font-size:14.5px;\">Add your details if you\u2019d like Adam and Chase to follow up. You can also view your result without sharing.</p>\n\n    <div class=\"field\">\n      <label for=\"fName\">First name</label>\n      <input type=\"text\" id=\"fName\" autocomplete=\"given-name\" placeholder=\"Jordan\">\n    </div>\n    <div class=\"field\">\n      <label for=\"fEmail\">Email</label>\n      <input type=\"email\" id=\"fEmail\" autocomplete=\"email\" placeholder=\"jordan@company.com\">\n    </div>\n    <div class=\"field\">\n      <label for=\"fPhone\">Phone <span class=\"opt-tag\">(optional, in case texting's easier)</span></label>\n      <input type=\"tel\" id=\"fPhone\" autocomplete=\"tel\" placeholder=\"(970) 555-0148\">\n    </div>\n\n    <div class=\"nav-row\">\n      <button class=\"back-link\" id=\"contactBackBtn\">\n        <svg viewBox=\"0 0 16 16\" width=\"13\" height=\"13\" fill=\"none\"><path d=\"M13 8H3M7 4L3 8l4 4\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n        Back\n      </button>\n      <button class=\"next-btn\" id=\"unlockBtn\" disabled>Share with RIPL &amp; See My Result</button>\n    </div>\n    <button class=\"back-link\" id=\"skipContactBtn\" type=\"button\">Just show my result</button><p id=\"deliveryStatus\" class=\"delivery-status\" role=\"status\"></p><p class=\"privacy-line\">Your name, contact details, and persona will be sent to Adam and Chase through FormSubmit so they can follow up. Individual answers stay in your browser. <a href=\"/privacy/\">Privacy details</a>.</p>\n  </section>\n\n  <!-- RESULTS -->\n  <section class=\"screen card\" id=\"screen-results\" hidden>\n    <div class=\"result-head\">\n      <div class=\"persona-icon\" id=\"personaIcon\"></div>\n      <span class=\"eyebrow\">Your Wealth Persona</span>\n      <h1 id=\"resultHeadline\"></h1>\n    </div>\n\n    <p class=\"result-intro\" id=\"resultIntro\"></p><p id=\"overlapNote\" class=\"overlap-note\"></p><p id=\"resultDeliveryStatus\" class=\"delivery-status\" role=\"status\"></p>\n\n    <div class=\"core-drives\">\n      <p><span class=\"drive-label\">Core Driver</span><span id=\"coreDriver\"></span></p>\n    </div>\n\n    <div class=\"feature-card strong\">\n      <h3>Your Strengths</h3>\n      <div id=\"strongPoints\"></div>\n    </div>\n\n    <div class=\"feature-card gap\">\n      <h3>Where It Could Be Costing You</h3>\n      <div id=\"gapPoints\"></div>\n    </div>\n\n    <div class=\"feature-card next\">\n      <h3>In Order to Reach Your Next Level</h3>\n      <div id=\"nextPoints\"></div>\n    </div>\n\n    <p class=\"disclaimer\">This is a 3-minute, self-reported read based on your own answers today. It's directional, not a formal analysis, and it's not investment, tax, or legal advice. The real picture comes from an actual conversation about how you're wired.</p>\n\n    <div class=\"cta-card\">\n      <h3 id=\"ctaHead\">Want more insight on how to get to that next level?</h3>\n      <p id=\"ctaBody\">See what The RIPL Effect could do for you. A deeper dive into the way you think, how money is moving through your life, and how one decision today can create a magnitude of difference in your future.</p>\n      <button class=\"cta-primary\" id=\"bookBtn\">\n        <span id=\"bookBtnLabel\">Book Your Strategy Session</span>\n        <svg viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M3 8h10M9 4l4 4-4 4\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n      </button>\n    </div>\n\n    <button class=\"restart\" id=\"restartBtn\">Start over</button>\n  </section>\n</div>\n\n";
const quizJS="\n(function(){\n  \"use strict\";\n\n  // Seven personas: mode times tendency, Builder/Accumulator/Navigator split two ways each,\n  // Steward stays one persona regardless of tendency, the spectrum changes pace there, not the gap.\n  var PERSONA_META = {\n    builder_bold:{ label:\"The Believer\",\n      icon:'<svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M12 21c-3.5 0-6-2.5-6-5.8 0-2.6 1.8-4.3 3-6.4.7-1.2.9-2.4.6-3.8 2.4 1 4.8 3.3 4.8 6.6 0 .9-.2 1.6-.4 2.2.9-.5 1.6-1.4 1.9-2.6 1 1.4 1.6 3 1.6 4 0 3.3-2.5 5.8-5.5 5.8z\" stroke=\"var(--gold-bright)\" stroke-width=\"1.5\" stroke-linejoin=\"round\"/></svg>',\n      identity:\"Everything you make goes back into what you're creating. You'd rather bet big on yourself than hold back and wonder what you left on the table.\",\n      driver:\"To build something whose value is undeniable, proof that betting everything on yourself was the right call.\",\n      strengthBullets:[\"Fast compounding\", \"Real conviction\", \"Willingness to go all in\"],\n      strengthBody:\"Big calls get made with real conviction instead of stalling out, and what you're building is worth more, sooner, because of it.\",\n      pitfallHead:\"There's no wall between the business and your life.\",\n      pitfallBody:\"Net worth is one concentrated bet, reactive by default, no defined finish line, so a bad stretch in the business is a bad stretch in everything.\",\n      next:[\n        { label:\"Set a real target\", text:\"Work with your team to define what financial freedom actually looks like for you, so decisions get made strategically instead of emotionally.\" },\n        { label:\"Take some chips off the table\", text:\"Look for one investment opportunity that exists outside your main role or business.\" }\n      ],\n      cta:\"learn\" },\n    builder_cautious:{ label:\"The Architect\",\n      icon:'<svg viewBox=\"0 0 24 24\" fill=\"none\"><rect x=\"4\" y=\"4\" width=\"16\" height=\"16\" rx=\"2\" stroke=\"var(--periwinkle)\" stroke-width=\"1.5\"/><path d=\"M4 12h16M12 4v16\" stroke=\"var(--periwinkle)\" stroke-width=\"1.1\"/><circle cx=\"12\" cy=\"12\" r=\"2.4\" stroke=\"var(--gold-bright)\" stroke-width=\"1.4\"/></svg>',\n      identity:\"You are a patient builder, intent on creating something of value but also aware of the cost if something were to go wrong.\",\n      driver:\"To get where you want to go without losing it all.\",\n      strengthBullets:[\"Personal cushion\", \"Thoughtful decision making\", \"Steadiness through crisis\"],\n      strengthBody:\"You're prepared for worst-case scenarios, and you won't get blindsided by unexpected shifts.\",\n      pitfallHead:\"The discipline can quietly become a ceiling.\",\n      pitfallBody:\"The opportunity cost that comes with caution can lead you to miss out on some of the moments of greatest growth.\",\n      next:[\n        { label:\"Set a real target\", text:\"Work with your team to define what financial freedom actually looks like for you, so decisions get made strategically instead of emotionally.\" },\n        { label:\"Take one strategic risk\", text:\"Identify one specific area where you're willing to take a real swing instead of waiting for total certainty first.\" }\n      ],\n      cta:\"learn\" },\n    accumulator_bold:{ label:\"The Accelerator\",\n      icon:'<svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M4 9h9M4 15h6\" stroke=\"var(--ink-faint)\" stroke-width=\"1.5\" stroke-linecap=\"round\"/><path d=\"M13 6l7 6-7 6\" stroke=\"var(--gold-bright)\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>',\n      identity:\"As your income has outpaced your structure, your instinct is to keep the money moving, looking for new positions, new ventures, and new opportunities.\",\n      driver:\"To know every dollar coming in is being put to its best use immediately.\",\n      strengthBullets:[\"Locating new opportunities\", \"Bold decision making\", \"Strong self-belief\"],\n      strengthBody:\"You have a knack for spotting potential and are not afraid to both bet on yourself and choose a new path.\",\n      pitfallHead:\"Finding opportunity is just the first half of the battle.\",\n      pitfallBody:\"The wisdom and patience required to sort through what you find and pick only the best opportunities can become difficult when moving at such a high pace.\",\n      next:[\n        { label:\"Build your advisory council\", text:\"Schedule regular time with the people you admire who you would trust to help you filter your decision making, and actively ask for their input with your choices.\" },\n        { label:\"Get one coordinated strategy in place\", text:\"Find a team that can help you evaluate and orient the scattered positions you already have before adding the next one.\" }\n      ],\n      cta:\"strategy\" },\n    accumulator_cautious:{ label:\"The Banker\",\n      icon:'<svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M3 9l9-5 9 5\" stroke=\"var(--gold-bright)\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M4 9h16M5 9v8M9 9v8M15 9v8M19 9v8\" stroke=\"var(--gold-bright)\" stroke-width=\"1.3\" stroke-linecap=\"round\"/><path d=\"M3 19.5h18\" stroke=\"var(--ink-faint)\" stroke-width=\"1.4\" stroke-linecap=\"round\"/></svg>',\n      identity:\"Your income is outpacing your spending, and it's creating real margin. That margin just sits in the bank, because there's never really been a plan for what to do with it.\",\n      driver:\"To make sure you never go backwards, each win adding to the previous and creating additional security.\",\n      strengthBullets:[\"A real safety net\", \"No exposure to overreach\", \"Capital ready to deploy\"],\n      strengthBody:\"You're not carrying invisible risk, and your money is ready to move the moment there's an actual plan.\",\n      pitfallHead:\"Capital that should be compounding is earning close to nothing.\",\n      pitfallBody:\"Real opportunity cost stacking up every year, scattered accounts likely carrying fees or tax inefficiency even sitting still.\",\n      next:[\n        { label:\"Optimize and consolidate\", text:\"Locate the cash accounts with the highest interest rates and consolidate where you can. Work with your financial team to make sure everything you have invested is growing efficiently, and combine accounts to eliminate strategic drag.\" },\n        { label:\"Set a cash threshold\", text:\"Work with your financial team to build a baseline cash number that serves as your emergency reserve. Once cash in the bank grows past that number, let it be your prompt to go find investment opportunities.\" }\n      ],\n      cta:\"strategy\" },\n    navigator_bold:{ label:\"The Pioneer\",\n      icon:'<svg viewBox=\"0 0 24 24\" fill=\"none\"><circle cx=\"12\" cy=\"12\" r=\"9\" stroke=\"var(--periwinkle)\" stroke-width=\"1.5\"/><path d=\"M15.5 8.5l-2.2 5-5 2.2 2.2-5 5-2.2z\" stroke=\"var(--gold-bright)\" stroke-width=\"1.3\" stroke-linejoin=\"round\"/><circle cx=\"12\" cy=\"12\" r=\"1\" fill=\"var(--gold-bright)\"/></svg>',\n      identity:\"You're in the middle of a major transition and have big money decisions to make. Your first instinct is to move, deploy, act, as the cost of missing out on growth feels more significant than the risk of making a bad decision.\",\n      driver:\"To be moving forward, pursuing the new thing while trusting your talents and abilities.\",\n      strengthBullets:[\"Deep conviction\", \"Quick action\", \"Purpose-forward thinking\"],\n      strengthBody:\"Your gut has gotten you this far and has already created exceptional value.\",\n      pitfallHead:\"This is the highest-stakes possible moment to move without a plan.\",\n      pitfallBody:\"A rushed decision here is largely irreversible, and the same urgency that got you here can work against you now.\",\n      next:[\n        { label:\"Build in a pause\", text:\"Put one mandatory pause before any major deployment decision, even just thirty days. Use that window to map out more than one path forward instead of committing to the first one that feels right.\" },\n        { label:\"Get everyone in the same room\", text:\"Bring everyone advising you together at the same time before anything moves. This is also a good time to evaluate whether your current team needs an upgrade anywhere before you go further.\" }\n      ],\n      cta:\"strategy\" },\n    navigator_cautious:{ label:\"The Guardian\",\n      icon:'<svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M12 3l7 3v6c0 4.5-3 7.7-7 9-4-1.3-7-4.5-7-9V6l7-3z\" stroke=\"var(--periwinkle)\" stroke-width=\"1.5\" stroke-linejoin=\"round\"/></svg>',\n      identity:\"You're in the middle of a major transition and have big money decisions to make. Your instinct is to protect and wait, often meaning the money sits entirely in cash while you \u201cfigure it out.\u201d\",\n      driver:\"To protect what took this long to build, long enough to be certain the next move is actually the right one.\",\n      strengthBullets:[\"Won't rush an irreversible decision\", \"Real safety in the pause\", \"Clear thinking under pressure\"],\n      strengthBody:\"You're buying real time to think clearly instead of reacting, and that pause is protecting you from the mistake that can't be undone.\",\n      pitfallHead:\"\u201cFiguring it out\u201d can quietly become permanent.\",\n      pitfallBody:\"Years of value lost to inflation while no decision gets made, the fear protecting you from one mistake creating a different, quieter one.\",\n      next:[\n        { label:\"Define your path with your team\", text:\"Bring in your team to help define a real path forward, and commit to making a decision, with their input, within a set amount of time.\" },\n        { label:\"Tier your opportunities\", text:\"Not everything needs to move at once, or into the same kind of risk. Build in stages instead, so you're making deliberate choices over time, staying protected while still capturing some of that growth.\" }\n      ],\n      cta:\"strategy\" },\n    steward:{ label:\"The Benefactor\",\n      icon:'<svg viewBox=\"0 0 24 24\" fill=\"none\"><circle cx=\"12\" cy=\"12\" r=\"4\" stroke=\"var(--gold-bright)\" stroke-width=\"1.5\"/><path d=\"M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M19 5l-2 2M7 17l-2 2\" stroke=\"var(--gold-bright)\" stroke-width=\"1.4\" stroke-linecap=\"round\"/></svg>',\n      identity:\"Your focus has shifted from building for yourself over to benefiting others, your family, community, and the causes you care about.\",\n      driver:\"To maximize the external potential of everything you've built.\",\n      strengthBullets:[\"Personal stability\", \"Freedom to think beyond yourself\", \"A mindset built for others\"],\n      strengthBody:\"Your answers suggest that supporting others matters to you. Your own financial needs still deserve a review alongside your giving and legacy goals.\",\n      pitfallHead:\"Intention without structure.\",\n      pitfallBody:\"If the people it's meant for don't know the plan or don't agree with it, that gap is where things actually break down. Just as risky is a poorly built giving plan. Without the right structure, the value you worked so hard to create can end up in hands other than the ones it was meant for.\",\n      next:[\n        { label:\"Host a family meeting\", text:\"Bring together every generation who's part of the plan, so everyone understands the structure and their role in it before it's ever needed.\" },\n        { label:\"Look at every angle\", text:\"Work with your team to run your options through the lens of tax, structure, cost, and connection, all four together, not just one. That combination is often what actually changes the outcome.\" }\n      ],\n      cta:\"strategy\" }\n  };\n\n  // Twelve statements, interleaved on purpose so no two screens in a row come from the same stage.\n  var MINDSET_STATEMENTS = [\n    { stage:\"navigator\", text:\"I'm either selling my business or just did, and I'm trying to figure out my purpose in this new season.\" },\n    { stage:\"builder\", text:\"All of my extra cash gets reinvested back into my business right now.\" },\n    { stage:\"steward\", text:\"Growing my business isn't the primary goal anymore, I'm more focused on what it can do for my family or the causes I care about.\" },\n    { stage:\"accumulator\", text:\"My business looks good on paper, but I don't feel as far along as the numbers suggest.\" },\n    { stage:\"builder\", text:\"I'm able to pay myself enough to cover my basic needs but don't have much room for savings at the moment.\" },\n    { stage:\"navigator\", text:\"Selling my business, and figuring out what to do with the money from it, is the biggest decision in front of me right now.\" },\n    { stage:\"steward\", text:\"When I think about my business and what it's worth, I think more about who I'll leave it to than about growing it further.\" },\n    { stage:\"accumulator\", text:\"My business is throwing off more cash than I know what to do with.\" },\n    { stage:\"builder\", text:\"Most of what I own is tied up in my business, not saved or set aside for the future.\" },\n    { stage:\"navigator\", text:\"I have more money than I've ever had, and I'm nervous about making the wrong move.\" },\n    { stage:\"accumulator\", text:\"My assets are scattered across different places, and I'm not sure they're all working the way I want.\" },\n    { stage:\"steward\", text:\"I'm not sure if my family knows my plan for everything I have built.\" }\n  ];\n\n  var RATE_LABELS = [\"Not me\", \"Feels like me\"];\n\n  // One universal tendency spectrum, five duels, applies to everyone regardless of stage or\n  // whether they're a business owner. Odd number on purpose, no tie is mathematically possible.\n  // Both sides of every pair are written as a genuine positive, neither side reads as the\n  // compromise option.\n  var TENDENCY_DUELS = [\n    { id:\"deployment\", bold:\"I like keeping my money moving, always looking for the next place for it to go.\", cautious:\"I like knowing exactly where my money is and watching it stay put.\" },\n    { id:\"newVentures\", bold:\"I love finding and backing new opportunities.\", cautious:\"I love having my money settled somewhere stable and proven.\" },\n    { id:\"team\", bold:\"I do my best thinking by myself.\", cautious:\"I want a team around me to support each decision.\" },\n    { id:\"volatility\", bold:\"I can stay calm through the ups and downs when I believe in where it's headed.\", cautious:\"I want what I've built to feel protected, steady, and dependable.\" },\n    { id:\"pace\", bold:\"I move fast and trust myself to adjust as I go.\", cautious:\"I take my time and trust that patience pays off.\" }\n  ];\n\n  // Build the flow: 2 screens of 6 stacked mindset statements each (interleaved order preserved\n  // so the four stages stay mixed across the set), then one screen holding all five tendency\n  // duels together. 3 screens total, down from 5, using the compact single-row rating control\n  // so 6 per screen still reads light rather than dense.\n  var RATE_GROUP_SIZE = 6;\n\n  var SCREENS = [];\n  for (var gi = 0; gi < MINDSET_STATEMENTS.length; gi += RATE_GROUP_SIZE){\n    var items = [];\n    for (var k = gi; k < Math.min(gi + RATE_GROUP_SIZE, MINDSET_STATEMENTS.length); k++){\n      items.push({ qid:\"rate_\" + k, stage:MINDSET_STATEMENTS[k].stage, text:MINDSET_STATEMENTS[k].text });\n    }\n    SCREENS.push({ type:\"rateGroup\", items:items });\n  }\n  SCREENS.push({ type:\"duelGroup\", items:TENDENCY_DUELS });\n\n  var state = { screenIndex:0, answers:{}, contact:{} };\n\n  var elLanding = document.getElementById(\"screen-landing\");\n  var elRate = document.getElementById(\"screen-rate\");\n  var elDuel = document.getElementById(\"screen-duel\");\n  var elContact = document.getElementById(\"screen-contact\");\n  var elResults = document.getElementById(\"screen-results\");\n  var progressWrap = document.getElementById(\"progressWrap\");\n  var progressLabel = document.getElementById(\"progressLabel\");\n  var progressFill = document.getElementById(\"progressFill\");\n\n  function checkSvg(){\n    return '<svg viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M3 8.5l3 3 7-7\" stroke=\"' +\n      (getComputedStyle(document.documentElement).getPropertyValue('--gold-ink') || '#2A1D08') +\n      '\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>';\n  }\n\n  function showOnly(el){\n    [elLanding, elRate, elDuel, elContact, elResults].forEach(function(s){ s.hidden = (s !== el); });\n    el.setAttribute(\"tabindex\",\"-1\"); el.focus({preventScroll:true});\n    el.classList.add(\"enter\");\n    requestAnimationFrame(function(){ el.classList.remove(\"enter\"); });\n    window.scrollTo({top:0, behavior:\"instant\" in window ? \"instant\" : \"auto\"});\n  }\n\n  function updateProgress(){\n    progressWrap.hidden = false;\n    var pos = state.screenIndex + 1;\n    progressLabel.textContent = pos + \" / \" + SCREENS.length;\n    progressFill.style.width = Math.round((pos / SCREENS.length) * 100) + \"%\";\n  }\n\n  function renderScreen(){\n    if (state.screenIndex >= SCREENS.length){ goContact(); return; }\n    var screen = SCREENS[state.screenIndex];\n    if (screen.type === \"rateGroup\") renderRateGroup(screen); else renderDuelGroup(screen);\n  }\n\n  function renderRateGroup(screen){\n    updateProgress();\n    document.getElementById(\"rateEyebrow\").textContent = \"Screen \" + (state.screenIndex + 1) + \" of \" + SCREENS.length;\n\n    var wrap = document.getElementById(\"rateGroupItems\");\n    wrap.innerHTML = \"\";\n\n    screen.items.forEach(function(item){\n      var block = document.createElement(\"div\");\n      block.className = \"rate-group-item\";\n\n      var title = document.createElement(\"h2\");\n      title.className = \"q-title\";\n      title.textContent = item.text;\n      block.appendChild(title);\n\n      var scale = document.createElement(\"div\");\n      scale.className = \"rate-scale\";\n      var saved = state.answers[item.qid];\n\n      RATE_LABELS.forEach(function(lbl, v){\n        var btn = document.createElement(\"button\");\n        btn.type = \"button\";\n        btn.className = \"rate-btn\" + (saved === v ? \" selected\" : \"\");\n        btn.textContent = lbl; btn.setAttribute(\"aria-pressed\", saved === v ? \"true\" : \"false\");\n        btn.addEventListener(\"click\", function(){\n          state.answers[item.qid] = v;\n          renderRateGroup(screen);\n          var buttons=wrap.querySelectorAll(\".rate-btn\"); buttons[screen.items.indexOf(item)*RATE_LABELS.length+v].focus({preventScroll:true});\n        });\n        scale.appendChild(btn);\n      });\n\n      block.appendChild(scale);\n      wrap.appendChild(block);\n    });\n\n    var allAnswered = screen.items.every(function(item){ return state.answers[item.qid] !== undefined; });\n    document.getElementById(\"rateContinueBtn\").disabled = !allAnswered;\n    document.getElementById(\"rateBackBtn\").style.visibility = (state.screenIndex === 0) ? \"hidden\" : \"visible\";\n  }\n\n  function renderDuelGroup(screen){\n    updateProgress();\n    document.getElementById(\"duelEyebrow\").textContent = \"Screen \" + (state.screenIndex + 1) + \" of \" + SCREENS.length;\n\n    var wrap = document.getElementById(\"duelGroupItems\");\n    wrap.innerHTML = \"\";\n\n    screen.items.forEach(function(duel){\n      var block = document.createElement(\"div\");\n      block.className = \"rate-group-item\";\n\n      var opts = document.createElement(\"div\");\n      opts.className = \"options\";\n      var saved = state.answers[\"tendency_\" + duel.id];\n\n      [[\"bold\", duel.bold], [\"cautious\", duel.cautious]].forEach(function(pair, idx){\n        var val = pair[0], label = pair[1];\n        var btn = document.createElement(\"button\");\n        btn.type = \"button\";\n        btn.className = \"opt opt-duel\"; btn.setAttribute(\"aria-pressed\", saved === val ? \"true\" : \"false\");\n        if (saved === val) btn.classList.add(\"selected\");\n        btn.innerHTML = '<span class=\"mark\">' + checkSvg() + '</span><span>' + label + \"</span>\";\n        btn.addEventListener(\"click\", function(){\n          state.answers[\"tendency_\" + duel.id] = val;\n          renderDuelGroup(screen);\n          wrap.querySelectorAll(\".opt\")[screen.items.indexOf(duel)*2+idx].focus({preventScroll:true});\n        });\n        opts.appendChild(btn);\n        if (idx === 0){\n          var div = document.createElement(\"div\");\n          div.className = \"duel-divider\";\n          div.textContent = \"or\";\n          opts.appendChild(div);\n        }\n      });\n\n      block.appendChild(opts);\n      wrap.appendChild(block);\n    });\n\n    var allAnswered = screen.items.every(function(duel){ return state.answers[\"tendency_\" + duel.id] !== undefined; });\n    document.getElementById(\"duelContinueBtn\").disabled = !allAnswered;\n    document.getElementById(\"duelBackBtn\").style.visibility = (state.screenIndex === 0) ? \"hidden\" : \"visible\";\n  }\n\n  function advance(){\n    state.screenIndex++;\n    if (state.screenIndex >= SCREENS.length){ goContact(); }\n    else {\n      var screen = SCREENS[state.screenIndex];\n      showOnly(screen.type === \"rateGroup\" ? elRate : elDuel);\n      renderScreen();\n    }\n  }\n\n  function goBack(){\n    state.screenIndex--;\n    if (state.screenIndex < 0){ showOnly(elLanding); return; }\n    var screen = SCREENS[state.screenIndex];\n    showOnly(screen.type === \"rateGroup\" ? elRate : elDuel);\n    renderScreen();\n  }\n  document.getElementById(\"rateBackBtn\").addEventListener(\"click\", goBack);\n  document.getElementById(\"duelBackBtn\").addEventListener(\"click\", goBack);\n  document.getElementById(\"rateContinueBtn\").addEventListener(\"click\", advance);\n  document.getElementById(\"duelContinueBtn\").addEventListener(\"click\", advance);\n\n  document.getElementById(\"startBtn\").addEventListener(\"click\", function(){\n    state.screenIndex = 0;\n    var screen = SCREENS[0];\n    showOnly(screen.type === \"rateGroup\" ? elRate : elDuel);\n    renderScreen();\n  });\n\n  function goContact(){\n    progressWrap.hidden = true;\n    showOnly(elContact);\n  }\n\n  document.getElementById(\"contactBackBtn\").addEventListener(\"click\", function(){\n    state.screenIndex = SCREENS.length - 1;\n    var screen = SCREENS[state.screenIndex];\n    showOnly(screen.type === \"rateGroup\" ? elRate : elDuel);\n    renderScreen();\n  });\n\n  function validateContact(){\n    var name = document.getElementById(\"fName\").value.trim();\n    var email = document.getElementById(\"fEmail\").value.trim();\n    var emailOk = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email);\n    document.getElementById(\"unlockBtn\").disabled = !(name.length > 0 && emailOk);\n  }\n  [\"fName\",\"fEmail\",\"fPhone\"].forEach(function(id){\n    document.getElementById(id).addEventListener(\"input\", validateContact);\n  });\n\n  document.getElementById(\"unlockBtn\").addEventListener(\"click\", async function(){\n    var btn=document.getElementById(\"unlockBtn\");\n    if(btn.disabled) return;\n    state.contact.name=document.getElementById(\"fName\").value.trim();\n    state.contact.email=document.getElementById(\"fEmail\").value.trim();\n    state.contact.phone=document.getElementById(\"fPhone\").value.trim();\n    btn.disabled=true;\n    document.getElementById(\"deliveryStatus\").textContent=\"Sending your result to Adam and Chase\u2026\";\n    var r=computeResults();\n    try {\n      var response=await fetch(\"https://formsubmit.co/ajax/adam@riplwealth.com\",{method:\"POST\",headers:{\"Content-Type\":\"application/json\",\"Accept\":\"application/json\"},body:JSON.stringify({name:state.contact.name,email:state.contact.email,phone:state.contact.phone,persona:r.noMatch?\"No clear stage match\":PERSONA_META[r.personaKey].label,overlapping_stages:r.overlapping.join(\", \"),_cc:\"chase@riplwealth.com\",_subject:\"RIPL Wealth Persona Assessment\",_template:\"table\",consent:\"Visitor requested RIPL follow-up\",source:window.location.origin+\"/assessment/\"})});\n      var data=await response.json();\n      if(!response.ok || !(data.success===true || data.success===\"true\")) throw new Error(\"Delivery not confirmed\");\n      document.getElementById(\"resultDeliveryStatus\").textContent=\"Your request was accepted for delivery to Adam and Chase.\";\n    } catch(e) {\n      document.getElementById(\"resultDeliveryStatus\").textContent=\"We couldn\u2019t confirm delivery. Your result is still available below. Please use the booking links or email adam@riplwealth.com if you\u2019d like to follow up.\";\n    }\n    document.getElementById(\"deliveryStatus\").textContent=\"\";\n    renderResults(); showOnly(elResults); btn.disabled=false;\n  });\n  document.getElementById(\"skipContactBtn\").addEventListener(\"click\",function(){state.contact={};document.getElementById(\"resultDeliveryStatus\").textContent=\"Your result has not been sent. Your answers stay in this browser.\";renderResults();showOnly(elResults);});\n\n  function computeResults(){\n    // Binary answers (0 or 1) across 3 statements per stage means a tie between two stages\n    // is realistic, not a rare edge case. Object key order below is the tiebreak: on an exact\n    // tie, whichever stage comes first here wins. Builder is deliberately listed last, since\n    // it's the one persona pair that doesn't route to a strategy session, so a coin-flip tie\n    // shouldn't default someone into it.\n    var stageScores = { accumulator:0, navigator:0, steward:0, builder:0 };\n    MINDSET_STATEMENTS.forEach(function(s, i){\n      var v = state.answers[\"rate_\" + i];\n      stageScores[s.stage] += (v || 0);\n    });\n\n    var stageOrder = Object.keys(stageScores).sort(function(a,b){ return stageScores[b] - stageScores[a]; });\n    var lead = stageOrder[0];\n\n    // Five duels, odd number, so this can never land on a tie.\n    var tendencyScore = TENDENCY_DUELS.filter(function(p){ return state.answers[\"tendency_\" + p.id] === \"bold\"; }).length;\n    var tendency = tendencyScore >= 3 ? \"bold\" : \"cautious\";\n\n    // Steward doesn't split, the tendency changes pace, not the underlying persona.\n    var personaKey = (lead === \"steward\") ? \"steward\" : (lead + \"_\" + tendency);\n\n    return { lead:lead, tendency:tendency, personaKey:personaKey, overlapping:stageOrder.filter(function(k){return stageScores[k]===stageScores[lead];}), noMatch:stageScores[lead]===0 };\n  }\n\n  function pointHtml(head, body){\n    return '<div class=\"point\"><div class=\"point-head\">' + head + '</div><div class=\"point-body\">' + body + '</div></div>';\n  }\n\n  function bulletListHtml(bullets){\n    return '<ul class=\"bullet-list\">' + bullets.map(function(b){ return \"<li>\" + b + \"</li>\"; }).join(\"\") + \"</ul>\";\n  }\n\n  var CTA_COPY = {\n    learn:{\n      head:\"Want to learn more about how you could move into the next stage?\",\n      body:\"Builder mode means every dollar goes back into what you're creating, that may reflect your current priorities. The balance between business reinvestment and personal reserves still matters. When you've created some margin and are ready to think about structure, The RIPL Effect is a good place to start.\",\n      btn:\"Learn More\"\n    },\n    strategy:{\n      head:\"Want more insight on how to get to that next level?\",\n      body:\"See what The RIPL Effect could do for you. A deeper dive into the way you think, how money is moving through your life, and how one decision today can create a magnitude of difference in your future.\",\n      btn:\"Book Your Strategy Session\"\n    }\n  };\n\n  function renderResults(forcedPersonaKey){\n    var r = forcedPersonaKey ? { personaKey:forcedPersonaKey } : computeResults();\n    var persona = PERSONA_META[r.personaKey];\n    var name = state.contact.name || \"\";\n\n    var headline=document.getElementById(\"resultHeadline\"); headline.textContent=(name?name+\", you're \":\"You're \"); var label=document.createElement(\"span\");label.className=\"highlight\";label.textContent=persona.label;headline.appendChild(label);headline.appendChild(document.createTextNode(\".\"));\n    var stages={builder:\"Builder\",accumulator:\"Accumulator\",navigator:\"Navigator\",steward:\"Steward\"};\n    document.getElementById(\"overlapNote\").textContent=r.noMatch?\"Your answers don\u2019t point clearly to one stage. Treat the example below as a starting point, rather than a personal conclusion.\":(r.overlapping&&r.overlapping.length>1?\"More than one stage resonated equally: \"+r.overlapping.map(function(k){return stages[k];}).join(\", \")+\". We\u2019re showing one possible persona below. A conversation can help connect the overlap.\":\"This is a starting point based on today\u2019s answers, not a complete picture of your finances.\");\n\n    document.getElementById(\"personaIcon\").innerHTML = persona.icon;\n    document.getElementById(\"resultIntro\").textContent = persona.identity;\n    document.getElementById(\"coreDriver\").textContent = persona.driver;\n\n    document.getElementById(\"strongPoints\").innerHTML =\n      bulletListHtml(persona.strengthBullets) + '<p class=\"point-tie\">' + persona.strengthBody + \"</p>\";\n\n    document.getElementById(\"gapPoints\").innerHTML =\n      pointHtml(persona.pitfallHead, persona.pitfallBody);\n\n    document.getElementById(\"nextPoints\").innerHTML =\n      persona.next.map(function(step){ return pointHtml(step.label, step.text); }).join(\"\");\n\n    var cta = CTA_COPY[persona.cta] || CTA_COPY.strategy;\n    document.getElementById(\"ctaHead\").textContent = cta.head;\n    document.getElementById(\"ctaBody\").textContent = cta.body;\n    document.getElementById(\"bookBtnLabel\").textContent = cta.btn;\n    state.currentCta = r.noMatch ? \"learn\" : persona.cta;\n  }\n\n  document.getElementById(\"restartBtn\").addEventListener(\"click\", function(){\n    state = { screenIndex:0, answers:{}, contact:{} };\n    document.getElementById(\"fName\").value = \"\";\n    document.getElementById(\"fEmail\").value = \"\";\n    document.getElementById(\"fPhone\").value = \"\";\n    validateContact(); progressWrap.hidden=true; document.getElementById(\"resultDeliveryStatus\").textContent=\"\"; showOnly(elLanding);\n  });\n\n  document.getElementById(\"bookBtn\").addEventListener(\"click\", function(e){\n    e.preventDefault();\n    if (state.currentCta === \"learn\"){\n      window.location.href=\"/business-owners/10-money-questions/\";\n    } else {\n      window.location.href=\"/contact/\";\n    }\n  });\n\n  // ---------- Preview mode ----------\n  // Two ways in, since the published artifact doesn't always give you an address bar to edit:\n  // 1) the \"Preview all 7 results\" link on the landing screen, works anywhere.\n  // 2) appending ?preview to the URL, for when you do have one, builds the nav on load.\n  // Either way it's the same floating nav, jumps straight to any persona's real result screen,\n  // no need to run the quiz to see or edit a result page.\n  var previewNavBuilt = false;\n  function buildPreviewNav(){\n    if (previewNavBuilt) return;\n    previewNavBuilt = true;\n\n    var PERSONA_ORDER = [\"builder_bold\",\"builder_cautious\",\"accumulator_bold\",\"accumulator_cautious\",\"navigator_bold\",\"navigator_cautious\",\"steward\"];\n    var nav = document.createElement(\"div\");\n    nav.className = \"preview-nav\";\n\n    var navLabel = document.createElement(\"span\");\n    navLabel.className = \"preview-nav-label\";\n    navLabel.textContent = \"Preview:\";\n    nav.appendChild(navLabel);\n\n    var landingBtn = document.createElement(\"button\");\n    landingBtn.type = \"button\";\n    landingBtn.className = \"preview-btn preview-btn-ghost\";\n    landingBtn.textContent = \"Landing\";\n    landingBtn.addEventListener(\"click\", function(){\n      progressWrap.hidden = true;\n      showOnly(elLanding);\n    });\n    nav.appendChild(landingBtn);\n\n    PERSONA_ORDER.forEach(function(key){\n      var btn = document.createElement(\"button\");\n      btn.type = \"button\";\n      btn.className = \"preview-btn\";\n      btn.textContent = PERSONA_META[key].label;\n      btn.addEventListener(\"click\", function(){\n        progressWrap.hidden = true;\n        renderResults(key);\n        showOnly(elResults);\n      });\n      nav.appendChild(btn);\n    });\n\n    document.body.appendChild(nav);\n  }\n\n  if (/[?&]preview\\b/.test(location.search)){\n    buildPreviewNav();\n  }\n  \n})();\n";
