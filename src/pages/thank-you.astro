---
import Layout from '../layout.astro';
---
<Layout title="Thanks | RIPL Wealth" description="Thanks for reaching out to RIPL." noindex={true}>
<section class="thank-you-page">
  <div class="wrap thank-you-wrap">
    <div class="eyebrow">MESSAGE RECEIVED</div>
    <h1>Thanks. I’ve got it.</h1>
    <p class="lead">Someone from our team will be in touch soon.</p>
    <p>If you’d rather skip the email back-and-forth, you can grab a time directly with our team.</p>
    <div class="thank-you-actions">
      <a class="btn" href="/contact/" target="_blank" rel="noopener noreferrer">Schedule a Conversation </a>
      <a class="text-link dark-link" href="/money-questions/">Explore Money Questions </a>
    </div>
  </div>
</section>
</Layout>
